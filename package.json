{
  "name": "mcp-security-sentinel",
  "version": "1.0.0",
  "description": "CLI red-team harness for evaluating AI agent response to malicious MCP tool content",
  "type": "module",
  "scripts": {
    "inspect": "tsx src/index.ts inspect",
    "attack": "tsx src/index.ts attack",
    "scan": "tsx src/index.ts attack",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:server": "tsx server/uiServer.ts",
    "ui:client": "cd ui && npm run dev",
    "ui": "npm run ui:server & npm run ui:client",
    "ui:build": "cd ui && npm run build",
    "ui:serve": "npm run ui:build && npm run ui:server"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ora": "^8.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
